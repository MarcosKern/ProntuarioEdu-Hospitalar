{
  "realm": "prontuarioedu",
  "enabled": true,
  "displayName": "ProntuarioEdu",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1)",
  "roles": {"realm": [{"name": "ADMINISTRADOR", "description": "Administração técnica da aplicação; acesso a prontuários exige autorização própria."}]},
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false", "display.on.consent.screen": "false"},
      "protocolMappers": [{"name": "subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": {"access.token.claim": "true", "introspection.token.claim": "true"}}]
    },
    {
      "name": "identity:read",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"},
      "protocolMappers": [{"name": "API audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": {"included.custom.audience": "prontuario-api", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true"}}]
    },
    {
      "name": "admin:access",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    }
  ],
  "scopeMappings": [{"clientScope": "admin:access", "roles": ["ADMINISTRADOR"]}],
  "clients": [
    {
      "clientId": "prontuario-swagger",
      "name": "Swagger de desenvolvimento",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${AUTH_SWAGGER_REDIRECT_URI}"],
      "webOrigins": ["${AUTH_SWAGGER_ORIGIN}"],
      "defaultClientScopes": ["basic", "identity:read"],
      "optionalClientScopes": ["admin:access"],
      "attributes": {"pkce.code.challenge.method": "S256"}
    }
  ],
  "users": [
    {
      "id": "${AUTH_ADMIN_USER_ID}",
      "username": "admin",
      "enabled": true,
      "firstName": "Administração",
      "lastName": "ProntuarioEdu",
      "requiredActions": ["UPDATE_PASSWORD"],
      "realmRoles": ["ADMINISTRADOR"],
      "credentials": [{"type": "password", "value": "${AUTH_ADMIN_TEMP_PASSWORD}", "temporary": true}]
    }
  ]
}
