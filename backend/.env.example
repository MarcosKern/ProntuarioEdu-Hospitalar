APP_ENV=development
# Obrigatório: URL real, com senha percent-encoded; nunca versionar a URL preenchida.
DATABASE_URL=
MYSQL_SSL_CA=
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=10
MYSQL_WRITE_TIMEOUT=10
MYSQL_POOL_TIMEOUT=5
# Somente para compose.tls.yaml: caminho absoluto da CA no host.
# MYSQL_SSL_CA_HOST=
# JSON arrays; no wildcard origins/hosts.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
MAX_BODY_BYTES=1048576
RATE_LIMIT=120
# Timeouts em segundos, maiores que zero e no máximo 30.
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
# CA privada opcional para Redis TLS; produção exige rediss://.
REDIS_SSL_CA=
OIDC_ISSUER=
# Identificador/audiência da API registrado no provedor.
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# O botão Authorize usa esta URL HTTPS para abrir o login do provedor.
OIDC_AUTHORIZATION_URL=
# O Swagger troca o código por token neste endpoint HTTPS (POST + PKCE).
OIDC_TOKEN_URL=
# Claim que contém os escopos do access token: scope (padrão OAuth2) ou scp.
OIDC_SCOPE_CLAIM=scope
# Recomendar renovação quando faltarem até estes segundos (0 a 3600).
OIDC_REFRESH_WINDOW_SECONDS=60
# ID público do cliente OAuth2 do Swagger, registrado no provedor com PKCE.
# Opcional para visualizar /docs. Não inserir client secret.
SWAGGER_CLIENT_ID=
# DATABASE_URL aponta para servidor MySQL externo, acessível da máquina/contêiner.
