APP_ENV=development
# Obrigatório: mysql+pymysql:// com servidor e database explícitos, sem fallback.
# Porta opcional: padrão 3306; se informada, deve estar entre 1 e 65535.
# Senha percent-encoded; nunca versionar a URL preenchida.
DATABASE_URL=
MYSQL_SSL_CA=
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=10
MYSQL_WRITE_TIMEOUT=10
MYSQL_POOL_TIMEOUT=5
# Somente para compose.tls.yaml: caminho absoluto da CA no host.
# MYSQL_SSL_CA_HOST=
# JSON arrays; no wildcard origins/hosts.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
MAX_BODY_BYTES=1048576
RATE_LIMIT=120
# Timeouts em segundos, maiores que zero e no máximo 30.
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
# CA privada opcional para Redis TLS; produção exige rediss://.
REDIS_SSL_CA=
# Obrigatório para login: segredo aleatório com ao menos 32 bytes, igual em todas as réplicas.
# Gerar localmente e guardar no .env ignorado ou no gerenciador de segredos; nunca versionar.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=prontuarioedu
AUTH_JWT_AUDIENCE=prontuario-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_WINDOW_SECONDS=60
# DATABASE_URL aponta para o MySQL escolhido, externo ou no modo explícito de desenvolvimento.
