APP_ENV=development
DATABASE_URL=sqlite:///./data/development.db
# JSON arrays; no wildcard origins/hosts.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
MAX_BODY_BYTES=1048576
RATE_LIMIT=120
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
# Compose supplies its own database/Redis URLs. Do not commit .env or passwords.
